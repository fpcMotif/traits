{
  "name": "traits",
  "version": "0.5.9",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crosshatch/traits.git",
    "directory": "traits"
  },
  "bin": {
    "traits": "./dist/bin.js"
  },
  "files": [
    "*.ts",
    "!vite.config.ts",
    "_util/**/*.ts",
    "skills/**/*.md",
    "toolkit/**/*.ts",
    "dist/package.json",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/vite.config.*",
    "!dist/integration/**"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./index.ts",
    "./*": "./*.ts",
    "./_util/*": null,
    "./index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./_util/*": null,
      "./index": null
    },
    "access": "public"
  },
  "dependencies": {
    "@effect/ai-typesafe": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "^4.0.0",
    "effect": "^4.0.0"
  }
}
