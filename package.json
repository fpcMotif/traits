{
  "name": "root",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": {
    "packages": [
      "traits",
      "traits.sh"
    ],
    "catalog": {
      "@changesets/changelog-github": "1.0.1",
      "@changesets/cli": "3.0.3",
      "@effect/ai-typesafe": "4.0.0",
      "@effect/atom-react": "4.0.0",
      "@effect/platform-browser": "4.0.0",
      "@effect/platform-node": "4.0.0",
      "@effect/tsgo": "0.47.2",
      "@effect/vitest": "4.0.0",
      "@fontsource/libre-baskerville": "5.3.0",
      "@types/node": "26.6.3",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "effect": "4.0.0",
      "pkg-pr-new": "0.0.91",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "typescript": "7.0.2",
      "varlock": "1.23.0",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
      "vite-plus": "1.0.0",
      "vitest": "5.0.1"
    }
  },
  "type": "module",
  "scripts": {
    "tasks": "node tasks/main.ts",
    "changeset": "changeset",
    "format": "vp fmt .",
    "prepare": "effect-tsgo patch --oxlint",
    "build": "tsc -b tsconfig.json",
    "check": "bun check -b",
    "test": "vp check && bun run check && bun run test:rules && bun run test:traits",
    "test:rules": "vp test run --project rules",
    "test:traits": "vp test run --project traits --passWithNoTests",
    "test:traits:integration": "varlock run -- vp test run --config traits.integration.config.ts"
  },
  "dependencies": {
    "effect": "catalog:",
    "traits": "workspace:*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/ai-typesafe": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "pkg-pr-new": "catalog:",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild"
  ]
}
