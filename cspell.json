{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "dictionaries": ["networking-terms", "project-words"],
  "dictionaryDefinitions": [
    {
      "addWords": true,
      "name": "project-words",
      "path": "./words.txt"
    }
  ],
  "enableGlobDot": true,
  "ignorePaths": [".worktrees/**", "LICENSE", "patches/**", "bun.lock", "repos/**"],
  "useGitignore": true,
  "version": "0.2"
}
