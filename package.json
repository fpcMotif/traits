{
  "name": "root",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "tasks": "node tasks/main.ts",
    "changeset": "changeset",
    "format": "bun fmt .",
    "lint": "bun lint",
    "lint:effect": "node tasks/main.ts effect-diagnostics",
    "build": "tsc -b tsconfig.json",
    "test": "bun fmt --check . && bun lint && bun run lint:effect && bun run build && bun run test:rules && bun run test:traits",
    "test:rules": "vp test run --project rules",
    "test:traits": "vp test run --project traits --passWithNoTests",
    "test:traits:integration": "vp test run --config traits.integration.config.ts"
  },
  "dependencies": {
    "alchemy": "catalog:",
    "effect": "catalog:",
    "traits": "workspace:*"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/ai-openrouter": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "pkg-pr-new": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.8.1"
}
